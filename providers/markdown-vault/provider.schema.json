{
  "schema_version": 1,
  "provider_type": "markdown-vault",
  "runtime_capabilities": ["knowledge_read", "knowledge_write", "knowledge_query"],
  "catalog": {
    "display_name": "Markdown Vault",
    "description": "Markdown vault search plus administrator REST CRUD for complete Knowledge aggregates and attachments.",
    "badge": "KB",
    "icon": "MD",
    "icon_path": "assets/icon.svg",
    "accent": "#2563eb"
  },
  "config_schema": {
    "default_auth_type": "app_credentials",
    "auth_modes": {
      "app_credentials": {
        "required_fields": []
      }
    },
    "fields": [
      {
        "name": "auth_type",
        "type": "hidden",
        "scope": "instance",
        "default": "app_credentials"
      },
      {
        "name": "vault_path",
        "type": "text",
        "required": true,
        "scope": "instance",
        "label": "Vault Path",
        "placeholder": "/Users/shared/knowledge-vault"
      },
      {
        "name": "tenant_id",
        "type": "text",
        "required": true,
        "scope": "instance",
        "default": "-1",
        "label": "Tenant ID",
        "placeholder": "-1"
      },
      {
        "name": "include_globs",
        "type": "text",
        "required": false,
        "scope": "instance",
        "default": "**/*.md",
        "label": "Include Globs",
        "placeholder": "**/*.md,docs/**/*.md"
      },
      {
        "name": "exclude_globs",
        "type": "text",
        "required": false,
        "scope": "instance",
        "default": ".obsidian/**,.git/**,**/.*/**,**/node_modules/**",
        "label": "Exclude Globs",
        "placeholder": ".obsidian/**,.git/**,private/**"
      },
      {
        "name": "max_file_bytes",
        "type": "number",
        "required": false,
        "scope": "instance",
        "default": 1048576,
        "label": "Max File Bytes",
        "placeholder": "1048576"
      },
      {
        "name": "max_chunk_chars",
        "type": "number",
        "required": false,
        "scope": "instance",
        "default": 1800,
        "label": "Max Chunk Characters",
        "placeholder": "1800"
      },
      {
        "name": "max_context_chars",
        "type": "number",
        "required": false,
        "scope": "instance",
        "default": 24576,
        "label": "Max Search Context Characters",
        "placeholder": "24576"
      },
      {
        "name": "max_result_chars",
        "type": "number",
        "required": false,
        "scope": "instance",
        "default": 3072,
        "label": "Max Result Characters",
        "placeholder": "3072"
      },
      {
        "name": "max_attachments",
        "type": "number",
        "required": false,
        "scope": "instance",
        "default": 20,
        "label": "Max Attachments",
        "placeholder": "20"
      },
      {
        "name": "max_attachment_bytes",
        "type": "number",
        "required": false,
        "scope": "instance",
        "default": 26214400,
        "label": "Max Attachment Bytes",
        "placeholder": "26214400"
      },
      {
        "name": "max_total_attachment_bytes",
        "type": "number",
        "required": false,
        "scope": "instance",
        "default": 104857600,
        "label": "Max Total Attachment Bytes",
        "placeholder": "104857600"
      },
      {
        "name": "conversion_timeout_seconds",
        "type": "number",
        "required": false,
        "scope": "instance",
        "default": 180,
        "label": "Attachment Conversion Timeout Seconds",
        "placeholder": "180"
      },
      {
        "name": "max_document_pages",
        "type": "number",
        "required": false,
        "scope": "instance",
        "default": 200,
        "label": "Max Document Pages",
        "placeholder": "200"
      },
      {
        "name": "max_conversion_output_chars",
        "type": "number",
        "required": false,
        "scope": "instance",
        "default": 1000000,
        "label": "Max Converted Markdown Characters",
        "placeholder": "1000000"
      },
      {
        "name": "max_rendered_page_bytes",
        "type": "number",
        "required": false,
        "scope": "instance",
        "default": 20971520,
        "label": "Max Rendered Page Bytes",
        "placeholder": "20971520"
      }
    ]
  },
  "redaction": {
    "sensitive_fields": []
  }
}
