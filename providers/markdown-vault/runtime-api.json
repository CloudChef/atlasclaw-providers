{
  "schema_version": 1,
  "routes": [
    {
      "method": "POST",
      "path": "knowledge/documents",
      "module": "http_runtime.py",
      "handler": "create_knowledge_document",
      "capability": "knowledge_write",
      "access": "admin",
      "success_status": 201
    },
    {
      "method": "GET",
      "path": "knowledge/documents/{knowledge_id}",
      "module": "http_runtime.py",
      "handler": "get_knowledge_document",
      "capability": "knowledge_read",
      "access": "provider_user"
    },
    {
      "method": "PUT",
      "path": "knowledge/documents/{knowledge_id}",
      "module": "http_runtime.py",
      "handler": "update_knowledge_document",
      "capability": "knowledge_write",
      "access": "admin"
    },
    {
      "method": "DELETE",
      "path": "knowledge/documents/{knowledge_id}",
      "module": "http_runtime.py",
      "handler": "delete_knowledge_document",
      "capability": "knowledge_write",
      "access": "admin"
    },
    {
      "method": "PUT",
      "path": "knowledge/documents/{knowledge_id}/unpublish",
      "module": "http_runtime.py",
      "handler": "unpublish_knowledge_document",
      "capability": "knowledge_write",
      "access": "admin"
    },
    {
      "method": "POST",
      "path": "knowledge/query",
      "module": "http_runtime.py",
      "handler": "query_knowledge_documents",
      "capability": "knowledge_query",
      "access": "provider_user"
    }
  ]
}
