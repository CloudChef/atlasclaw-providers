{
  "schema_version": 1,
  "provider_type": "audit-report",
  "catalog": {
    "display_name": "文件审核",
    "description": "上传检测报告、检测标准和台账，由 AI 审核并下载脱敏 PDF 与审核 PDF。",
    "badge": "AUDIT",
    "icon": "AR",
    "icon_path": "assets/icon.svg",
    "accent": "#1d4ed8",
    "extension_only": true
  },
  "runtime_capabilities": ["documents", "audit"],
  "extensions": {
    "version": 1,
    "requires": { "host": ">=1.0 <2.0" },
    "ui": {
      "assets_root": "ui",
      "nav": [
        {
          "id": "file-audit",
          "title": { "zh-CN": "文件审核", "en-US": "File Audit" },
          "i18n_key": "ext.auditReport.fileAudit",
          "icon_path": "assets/icon.svg",
          "entry": "index.html",
          "access": "user",
          "layout": "full",
          "order": 10
        }
      ]
    },
    "api": {
      "manifest": "runtime-api.json",
      "timeout_seconds": 30,
      "max_body_bytes": 33554432
    }
  },
  "config_schema": {
    "fields": [
      {
        "name": "reports_dir",
        "type": "text",
        "required": false,
        "scope": "instance",
        "default": "",
        "label": "Report storage directory",
        "placeholder": "/opt/atlasclaw/documents/provider/audit-report/reports"
      },
      {
        "name": "standards_dir",
        "type": "text",
        "required": false,
        "scope": "instance",
        "default": "",
        "label": "Shared standards storage directory",
        "placeholder": "/opt/atlasclaw/documents/provider/audit-report/standards"
      }
    ]
  }
}
