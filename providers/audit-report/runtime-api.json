      "path": "documents/{document_id}/desensitized",
      "module": "api/handlers.py"
    },
    {
      "response": "binary",
      "access": "user",
      "capability": "documents",
      "method": "GET",
      "handler": "download_desensitized_file",
      "id": "documents.desensitized_download",
      "path": "documents/{document_id}/desensitized/download",
      "module": "api/handlers.py"
    },
    {
      "method": "POST",
      "path": "standards/{standard_id}/refresh",
      "success_status": 202,
      "module": "api/handlers.py",
      "access": "user",
      "response": "json",
      "capability": "documents",
      "handler": "refresh_standard",
      "id": "standards.refresh"
    }
