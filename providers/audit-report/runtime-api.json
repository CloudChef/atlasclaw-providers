    {
      "id": "standards.file",
      "method": "GET",
      "path": "standards/{standard_id}/file",
      "module": "api/handlers.py",
      "handler": "download_standard",
      "capability": "documents",
      "access": "user",
      "response": "binary"
    },
    {
      "id": "standards.recompile",
      "method": "POST",
      "path": "standards/{standard_id}/recompile",
      "module": "api/handlers.py",
      "handler": "recompile_standard",
      "capability": "documents",
      "access": "user",
      "success_status": 202,
      "response": "json"
