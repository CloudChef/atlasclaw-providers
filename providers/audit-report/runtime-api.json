      "capability": "documents",
      "access": "user",
      "response": "binary"
    },
    {
      "id": "documents.delete",
      "method": "DELETE",
      "path": "documents/{document_id}",
      "module": "api/handlers.py",
      "handler": "delete_document",
      "capability": "documents",
      "access": "user",
      "response": "json"
    },
    {
      "id": "standards.list",
      "method": "GET",
      "path": "standards",
      "module": "api/handlers.py",
      "handler": "list_standards",
