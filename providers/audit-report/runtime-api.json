      "method": "GET",
      "path": "documents",
      "module": "api/handlers.py",
      "handler": "list_documents",
      "capability": "documents",
      "access": "user",
      "response": "json"
    },
    {
      "id": "documents.upload",
      "method": "POST",
      "path": "documents",
      "module": "api/handlers.py",
      "handler": "upload_document",
      "capability": "documents",
      "access": "user",
      "success_status": 201,
      "response": "json",
      "timeout_seconds": 600,
      "max_body_bytes": 268435456
    },
    {
      "id": "documents.get",
      "method": "GET",
      "path": "documents/{document_id}",
      "module": "api/handlers.py",
      "handler": "get_document",
      "capability": "documents",
      "access": "user",
      "response": "json"
    },
    {
      "id": "documents.audit",
      "method": "POST",
      "path": "documents/{document_id}/audit",
      "module": "api/handlers.py",
      "handler": "start_audit",
      "capability": "audit",
      "access": "user",
      "success_status": 202,
      "response": "json",
      "timeout_seconds": 30
    },
    {
      "id": "documents.report_regenerate",
      "method": "POST",
      "path": "documents/{document_id}/report/regenerate",
